import numpy as np
import matplotlib.pyplot as plt

hbar = 1.054e-34
m = 9.1e-31
e = 1.602e-19

L = 1e-9
N = 500

x = np.linspace(0, L, N)
dx = x[1] - x[0]

t = hbar**2/(2*m*dx**2)

H = np.diag(2*t*np.ones(N-2))
H += np.diag(-t*np.ones(N-3), 1)
H += np.diag(-t*np.ones(N-3), -1)

E, psi = np.linalg.eigh(H)
E = E/e

print("Energy levels in eV:")
for i in range(5):
    print(E[i])

plt.figure()

for i in range(3):
    y = psi[:, i]
    y = y/np.max(np.abs(y))
    plt.plot(x[1:-1], E[i] + 0.5*y, label=f"n = {i+1}")

plt.xlabel("Position (m)")
plt.ylabel("Energy (eV)")
plt.title("Particle in a Box")
plt.legend()
plt.grid()
plt.show()
